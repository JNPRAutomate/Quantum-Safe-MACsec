# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.python-version

# Virtual environments
venv/
.venv/
env/

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.venv-docs/
site/

# Packaging/build outputs
build/
dist/
*.egg-info/

# macOS
.DS_Store

# Local defect-analysis artifacts
errata/

# KME runtime
certs/
/tests/certs/

# Generated QKD runtime artifacts (local only)
config/runtime/

# KME orchestrator runtime state (regenerated automatically per environment)
config/kme/state/*.yaml

# Legacy local backups (keep archived legacy snapshots tracked)
*.orig.py
!archive/legacy_orig_py/**/*.orig.py

# Generated by tools/generate_lab_config.py and tools/customer_setup.py.
# Environment files hold passwords; generated KME files hold the database
# password. Review and add a generated inventory explicitly if it must be kept.
config/kme/*.env
config/inventory/input/*.env
config/kme/*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z.yaml
